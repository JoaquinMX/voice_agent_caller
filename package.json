{
  "name": "voice_agent_caller",
  "version": "1.0.0",
  "description": "Minimal voice bot for outbound calls to Mexico with slot filling conversation.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc --noEmit false",
    "lint": "eslint .",
    "test": "jest",
    "call": "node -e \"(async()=>{const to=process.argv[2]; if(!to) throw new Error('Usage: npm run call -- +52...'); const axios=require('axios'); await axios.post('http://localhost:3000/dev/call',{to}); console.log('Call requested to',to);})().catch(e=>{console.error(e);process.exit(1);})\""
  },
  "keywords": [
    "twilio",
    "voice",
    "spanish",
    "mexico"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "twilio": "^4.22.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
